<?xml version="1.0"?>
<configuration>
	<connectionStrings>
		<add name="RailDb" connectionString="Server=(localdb)\MSSQLLocalDB;Database=RailOneDb;Integrated Security=true" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.web>
		<compilation debug="true" targetFramework="4.8"/>
		<httpRuntime targetFramework="4.8"/>
	</system.web>
</configuration>
