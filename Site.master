<%@ Master Language="C#" %>
<script runat="server">
    protected void Page_Load(object s, EventArgs e)
    {
        bool in_ = Session["UserId"] != null;
        lnkLogin.Visible = !in_; lnkLogout.Visible = in_;
        lblUser.Text = in_ ? "Hi, " + Session["Name"] : "";
    }
    protected void lnkLogout_Click(object s, EventArgs e) { Session.Clear(); Response.Redirect("Default.aspx"); }
</script>
<!DOCTYPE html>
<html>
<head runat="server">
  <title>RailOne - Railway Ticket Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<form id="form1" runat="server">
  <nav class="navbar navbar-expand navbar-dark px-3" style="background:#1a4b8c">
    <a class="navbar-brand fw-bold" href="Default.aspx">🚆 RailOne</a>
    <div class="navbar-nav me-auto">
      <a class="nav-link" href="Default.aspx">Book Ticket</a>
      <a class="nav-link" href="Pnr.aspx">PNR Status / Cancel</a>
    </div>
    <span class="text-white me-3"><asp:Label ID="lblUser" runat="server" /></span>
    <a id="lnkLogin" runat="server" class="btn btn-warning btn-sm" href="Login.aspx">Login</a>
    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="btn btn-outline-light btn-sm" OnClick="lnkLogout_Click">Logout</asp:LinkButton>
  </nav>
  <div class="container py-4"><asp:ContentPlaceHolder ID="body" runat="server" /></div>
</form>
</body>
</html>
